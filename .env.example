# =========================================================
# Mako Desk — runtime configuration
# Copy to .env and edit. Read at runtime: restart the server
# after changes (no rebuild needed).
# =========================================================

# --- Site ---
SITE_URL=https://makodesk.xyz
PORT=3000

# --- Mode ---
# true  = server runs the preview market engine (simulated desk data, clearly labelled)
# false = read live data from chain (set the addresses below first)
MAKO_PREVIEW_MODE=false

# --- Elysium network (mainnet values from elysium.kinetiq.xyz/docs; testnet is 99801 / https://testnet-rpc.elysium.kinetiq.xyz) ---
ELYSIUM_CHAIN_ID=99901
ELYSIUM_RPC_URL=https://rpc.elysium.kinetiq.xyz
ELYSIUM_EXPLORER_URL=https://elysium.kinetiq.xyz/explorer

# --- Contracts (leave empty until deployed) ---
MAKO_TOKEN_ADDRESS=0xbf74a922615caf3f1e8c803851557d2d5f3172e8
MAKO_DESK_ADDRESS=
MAKO_LP_ADDRESS=

# --- Links ---
MAKO_SWAP_URL=
MAKO_BRIDGE_URL=
MAKO_CHART_URL=
MAKO_X_URL=https://x.com/makodeskapp
MAKO_TELEGRAM_URL=https://t.me/makodesk

# --- Sessions & chat ---
# REQUIRED in production: 32+ random chars (e.g. `openssl rand -hex 32`).
# Signs the wallet-session and guest cookies. If unset, a random per-process
# secret is used and everyone is signed out on every restart.
SESSION_SECRET=
# Comma-separated wallet addresses with chat moderation rights (TEAM badge,
# delete any message, mute/purge, pin, slow mode).
CHAT_ADMINS=
# true = visitors can chat with a guest name (no links allowed, stricter limits)
# false = wallet sign-in required to post
CHAT_ALLOW_GUESTS=true
# Where chat history is stored (chat.json). Docker and PM2 set this for you
# (/app/data volume, <project>/data). Use an absolute path if running by hand.
# DATA_DIR=/var/lib/makodesk

# --- Abuse limits ---
# Behind nginx keep true (client IP from X-Forwarded-For). Set false if the
# Node server is exposed directly, so the header can't be spoofed.
TRUST_PROXY=true
# Max concurrent live streams (desk + chat, each) per client IP
SSE_MAX_PER_IP=12

# --- Phase 2: live market data ---
# hyperliquid = live HYPE-PERP book/trades/candles/funding from Hyperliquid's public API
# preview     = simulated market (offline/dev)
MARKET_DATA=hyperliquid
# Off-chain wick detector (mirrors MakoDesk): drop % within window AND trade flow >= USD
WICK_DROP_PCT=1.5
WICK_WINDOW_MS=3000
WICK_FLOW_USD=1000000

# --- Phase 3: live desk reader ---
# Block MakoDesk was deployed at (log backfill start) and polling interval
DESK_DEPLOY_BLOCK=
DESK_POLL_MS=2000
RPC_LOG_CHUNK=5000

# --- Keeper (keeper/keeper.mjs, separate process) ---
# The keeper never trades: it only pokes, settles and executes budgeted buybacks.
KEEPER_PRIVATE_KEY=
POKE_MS=1000
BUYBACK_SLIPPAGE_BPS=150
BUYBACK_MAX_HYPE=25
DRY_RUN=false
